# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=arthaguide

# JWT Configuration
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# PayPal SANDBOX only. Merchant business app; separate personal buyer account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BUYER_EMAIL=
# Optional absolute path; default backend/data/demo.sqlite3
# DEMO_DB_PATH=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Qdrant (optional - using in-memory mode by default)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
